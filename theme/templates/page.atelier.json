    "lg_steps": {
      "type": "lg-steps",
      "blocks": {
        "e1": {
          "type": "step",
          "settings": {
            "title": "Sélection",
            "text": "Boîtier, lunette, cadran et aiguilles choisis pièce par pièce, puis contrôlés à la loupe. Toute pièce marquée part au rebut."
          }
        },
        "e2": {
          "type": "step",
          "settings": {
            "title": "Montage",
            "text": "Pose du mouvement NH35, alignement des aiguilles et du guichet de date sous binoculaire, dans une boîte à poussière."
          }
        },
        "e3": {
          "type": "step",
          "settings": {
            "title": "Réglage",
            "text": "Passage au chronocomparateur dans cinq positions, ajustement de la raquetterie jusqu'à moins de 8 secondes d'écart par jour."
          }
        },
        "e4": {
          "type": "step",
          "settings": {
            "title": "Contrôle",
            "text": "Test d'étanchéité à sec, nettoyage aux ultrasons, 24 heures de marche à vide, puis photo de la pièce exacte qui part chez vous."
          }
        }
      },
